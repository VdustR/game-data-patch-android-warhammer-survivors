{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.cache/node.tsbuildinfo"
  },
  "include": [
    "src/core.ts",
    "src/cli.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "reset.d.ts"
  ]
}
